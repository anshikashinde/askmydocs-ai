# AskMyDocs AI local environment example
# Copy this file to .env for local configuration.

APP_ENV=development
APP_NAME=askmydocs-ai
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
SEC_USER_AGENT=AskMyDocsAI/0.1 your.email@example.com
SEC_TIMEOUT_SECONDS=20
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=.cache/huggingface
VECTOR_INDEX_DIRECTORY=.data/vector-index
TARGET_CHUNK_TOKENS=800
MAX_CHUNK_TOKENS=1000
MIN_CHUNK_TOKENS=100
OVERLAP_TOKENS=100
CHUNKING_VERSION=1
TOKENIZER_ENCODING=cl100k_base
